# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-a-chave-publica-anon
# Chave de serviço: só para scripts locais e Edge Functions. Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ClickUp — app OAuth (cada gestor conecta a própria conta; tokens ficam no Supabase Vault).
# Em produção ficam nos segredos das Edge Functions: supabase secrets set CLICKUP_CLIENT_ID=...
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# Plano B (sem OAuth): token único, começa com pk_
CLICKUP_TOKEN=
# Opcional: só se o token enxergar mais de um workspace
CLICKUP_TEAM_ID=
# O espaço (90133723590) fica em configuracoes.sincronizacao. O segredo do webhook vai sozinho
# para o Supabase Vault quando o webhook é registrado pela tela (D21).
